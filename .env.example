# Atheneum API Keys Configuration
# Copy this file to .env and add your actual API keys
# NEVER commit .env to git (it's in .gitignore)

# Get free keys at https://console.groq.com
# Generate new key and paste here
GROQ_API_KEY=your_groq_api_key_here

# Get free keys at https://cloud.cerebras.ai
# Generate new key and paste here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional: Custom Groq Model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Custom Cerebras Model (default: llama-3.3-70b)
# CEREBRAS_MODEL=llama-3.3-70b

# Optional: Debug mode (default: false)
# DEBUG=false
